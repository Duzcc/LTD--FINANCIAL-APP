# Sao chép thành .env rồi điền giá trị thật
NODE_ENV=development
PORT=3000
# MongoDB trên máy: mongodb://127.0.0.1:27017/finance_app
# MongoDB Atlas: mongodb+srv://<user>:<mật khẩu mã hóa URL>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/finance_app
# Tên cơ sở dữ liệu (bỏ trống: lấy từ MONGODB_URI, mặc định finance_app)
MONGODB_DB=
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=1h
# Origin của frontend được phép gọi API, phân tách bằng dấu phẩy ("*" = tất cả)
CORS_ORIGINS=*
# Địa chỉ công khai của backend (tên miền thật hoặc https://xxxx.ngrok-free.app) cho webhook SePay
PUBLIC_URL=
# OTP đăng nhập/đăng ký qua email (phút, giây) và khóa đăng nhập khi sai mật khẩu nhiều lần
OTP_MINUTES=5
OTP_RESEND_SECONDS=60
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15
RESET_CODE_MINUTES=15
# SMTP để gửi mã quên mật khẩu (bỏ trống: chế độ dev trả mã trong phản hồi API)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Quản lý chi tiêu <no-reply@example.com>
# Refresh token (ngày)
REFRESH_TOKEN_DAYS=30
# ---- Dịch vụ AI riêng (thư mục ai-service/, Python FastAPI) ----
# Để trống AI_SERVICE_URL: backend tự trả lời trợ lý bằng LLM trực tiếp (bên dưới) hoặc luật; app dùng mô hình trên thiết bị.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=change-me
AI_SERVICE_TIMEOUT_MS=30000
AI_RATE_LIMIT=30
# ---- LLM trực tiếp — phương án dự phòng khi AI service không chạy ----
# AI_PROVIDER=anthropic  AI_API_KEY=<khóa Anthropic>  AI_MODEL=<tên model Claude, ví dụ claude-sonnet-5-5>
# AI_PROVIDER=openai     AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1   (Ollama/LM Studio/OpenAI)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=800
