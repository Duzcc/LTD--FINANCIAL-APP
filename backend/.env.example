# Sao chép thành .env rồi điền giá trị thật
NODE_ENV=development
PORT=3000
# MongoDB trên máy: mongodb://127.0.0.1:27017/finance_app
# MongoDB Atlas: mongodb+srv://<user>:<mật khẩu mã hóa URL>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/finance_app
# Tên cơ sở dữ liệu (bỏ trống: lấy từ MONGODB_URI, mặc định finance_app)
MONGODB_DB=
# Tạo khóa production bằng: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Origin của frontend được phép gọi API, phân tách bằng dấu phẩy ("*" = tất cả)
CORS_ORIGINS=*
# Địa chỉ công khai của backend (production phải dùng HTTPS), dùng cho webhook SePay và liên kết email
PUBLIC_URL=
# SePay User API Token (my.sepay.vn → Cấu hình công ty → API Access): backend tự hỏi giao dịch mới để đối soát
# mã VietQR, không cần địa chỉ công khai. Bỏ trống = chỉ dùng webhook.
SEPAY_API_TOKEN=
SEPAY_POLL_SECONDS=15
# Email tài khoản trong app sở hữu tài khoản SePay ở trên. Giao dịch không có mã VietQR (chuyển/nhận thường)
# của số tài khoản đã liên kết với ví chỉ được ghi cho tài khoản này. Bỏ trống = chỉ ghi giao dịch có mã QR.
SEPAY_OWNER_EMAIL=
# Số lần nhập sai mật khẩu trước khi khóa; thời hạn liên kết đặt lại mật khẩu và xác minh email
MAX_FAILED_LOGINS=5
# Thời gian khóa tính bằng phút (demo 30 giây: 0.5)
LOGIN_LOCK_MINUTES=15
RESET_TOKEN_MINUTES=15
EMAIL_VERIFY_MINUTES=1440
# SMTP gửi liên kết xác minh email và đặt lại mật khẩu (dev không cấu hình thì in liên kết ra log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Quản lý chi tiêu <no-reply@example.com>
# Máy chủ chặn cổng SMTP (gói miễn phí Render, Railway): gửi mail qua API Brevo, MAIL_FROM phải là email đã xác minh trên Brevo
BREVO_API_KEY=
# Refresh token (ngày)
REFRESH_TOKEN_DAYS=30
# Dịch vụ AI riêng (thư mục ai-service/, Python FastAPI)
# Để trống AI_SERVICE_URL: backend tự trả lời trợ lý bằng LLM trực tiếp (bên dưới) hoặc luật; app dùng mô hình trên thiết bị.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=change-me
AI_SERVICE_TIMEOUT_MS=30000
AI_RATE_LIMIT=30
# LLM trực tiếp — phương án dự phòng khi AI service không chạy
# AI_PROVIDER=anthropic  AI_API_KEY=<khóa Anthropic>  AI_MODEL=<tên model Claude, ví dụ claude-sonnet-5-5>
# AI_PROVIDER=openai     AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1   (Ollama/LM Studio/OpenAI)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=800
