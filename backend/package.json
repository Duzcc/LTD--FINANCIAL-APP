{
  "name": "finance-app-backend",
  "version": "1.1.0",
  "description": "RESTful API cho Ứng dụng quản lý chi tiêu cá nhân (Nhóm 03 – Lập trình di động)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "E2E_AI_URL=${E2E_AI_URL:-http://127.0.0.1:8000} node --test test/ai.test.js",
    "dev:mem": "node src/dev-memory.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "morgan": "^1.12.1",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
