# Dùng cho docker compose ở thư mục gốc
# Tạo khóa production bằng: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
AI_SERVICE_KEY=thay-bang-chuoi-ngau-nhien-khac
CORS_ORIGINS=*
# Địa chỉ backend HTTPS công khai dùng cho liên kết xác minh/đặt lại mật khẩu ở production
PUBLIC_URL=
# Cấu hình Brevo hoặc SMTP để gửi liên kết email
BREVO_API_KEY=
MAIL_FROM=Wisely <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Trợ lý LLM (tùy chọn). Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5
# Hoặc Ollama (docker compose --profile llm up -d; rồi: docker compose exec ollama ollama pull qwen2.5:7b)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b
