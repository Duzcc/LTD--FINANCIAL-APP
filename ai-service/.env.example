# ---- Bảo mật giữa backend và AI service (đặt giống AI_SERVICE_KEY ở backend) ----
SERVICE_API_KEY=change-me
ENVIRONMENT=development

# ---- Trợ lý dùng mô hình ngôn ngữ lớn (tùy chọn; để trống = trợ lý luật, vẫn chạy đầy đủ) ----
# Claude (Anthropic):
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5
#
# Mô hình mở chạy trên máy qua Ollama (ollama pull qwen2.5:7b):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
#
# Mô hình thị giác đọc ảnh hóa đơn (để trống = dùng LLM_MODEL), ví dụ llava hoặc qwen2.5vl qua Ollama
# VISION_MODEL=
